{
  "schema_version": 1,
  "season": "S01",
  "source_basename_pattern": "^坑王驾到S01E(?P<episode>\\d{2,3})\\.",
  "cut": {
    "mode": "stream_copy",
    "opening_seconds": 30,
    "tail": "first_white_frame",
    "scan_tail_seconds": [
      180,
      300,
      600
    ],
    "allow_extra_cut_only": true,
    "tail_safety_seconds": 0.25
  },
  "ocr": {
    "backend_preference": "VideOCR",
    "use_ui_baseline_defaults": true,
    "crop": {
      "horizontal": "full_width",
      "vertical": "auto_from_representative_samples",
      "include_short_long_two_line": true
    },
    "preserve_visible_spaces": true,
    "forbid_invented_punctuation": true,
    "remove_background_clothes_logo": true
  },
  "master": {
    "engine": "DaVinci Resolve Studio",
    "human_steps": [
      "Magic Mask",
      "scenic background composition",
      "Fairlight mix"
    ],
    "track_reference_db": {
      "background": -14,
      "show": 10
    },
    "check_peak_and_clipping": true,
    "peak_policy": "diagnostic_only_user_accepts_rare_table_hit_clipping",
    "residual_hardsubs": "accepted"
  },
  "post": {
    "quality_target": "1080p60",
    "interpolation": "RIFE_scene_cut_aware",
    "upscale": "test_against_no_upscale",
    "subtitle": "ASS_final_stage",
    "audio_preset": "bilibili_hires"
  },
  "cut_review": {
    "mode": "stream_copy",
    "opening_scope": "within_each_season_not_across_seasons",
    "opening_search_seconds": [
      27,
      33
    ],
    "opening_policy": "first_live_entrance_or_percussion_after_title; indoor_first_live_if_no_entrance",
    "tail_policy": "per_episode_review_before_first_outro_transition; preserve_closing_wide_if_present",
    "tail_kinds": [
      "logo_transition",
      "preview",
      "credits",
      "clean_eof",
      "white_flash"
    ],
    "tail_safety_seconds": 0.25,
    "max_opening_keyframe_skip_seconds": 5,
    "source_sha256_bound_review_required": true,
    "allow_extra_cut_only": true,
    "sampled_episodes": [
      "S01E01",
      "S01E49",
      "S01E57",
      "S01E58"
    ],
    "sample_scope": "selected heads/tails only; not every episode; not audio review"
  },
  "known_cut_catalog": {
    "path": "config/cuts/four-seasons-known-v1.json",
    "episode_count": 58,
    "reference_intro_end_seconds": 30.0,
    "actual_start": "source_sha256_bound_entry.opening_seconds",
    "runtime_detection_required": false,
    "unknown_source_policy": "reject_and_keep_original"
  }
}
